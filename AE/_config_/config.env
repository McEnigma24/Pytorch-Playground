# Edytuj raz po sklonowaniu szablonu. Używane przez docker compose i skrypty hosta.
# Dwa projekty naraz: ustaw różne JUPYTER_PORT i TENSORBOARD_PORT.
PROJECT_NAME=ml_template
PROJECT_DISPLAY_NAME="ML Template (CUDA / Docker)"

JUPYTER_PORT=8888
TENSORBOARD_PORT=6006
JUPYTER_NOTEBOOK_DIR=/workspace/notebooks
TENSORBOARD_LOGDIR=/workspace/runs
PYTHONPATH_EXTRA=
