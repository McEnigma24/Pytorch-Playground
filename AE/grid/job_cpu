#!/bin/bash
#SBATCH --job-name=lrnn_cpu
#SBATCH --account=plgar2026-cpu
#SBATCH --partition=cpu-lowprio
#SBATCH --time=02:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --output=output/out.txt
#SBATCH --error=output/err.txt

set -euo pipefail

cd "$SLURM_SUBMIT_DIR"
# shellcheck source=/dev/null
[[ -f local/env.sh ]] && source local/env.sh

export OMP_NUM_THREADS="${OMP_NUM_THREADS:-${SLURM_CPUS_PER_TASK:-4}}"
export HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-1}"

PROJECT_ROOT="${LANGUAGE_RNN_ROOT:-$SLURM_SUBMIT_DIR}"
export PYTHONPATH="${PROJECT_ROOT}/src:${PYTHONPATH:-}"

echo "SLURM_NTASKS=${SLURM_NTASKS} LRNN_SHELL_CMD=${LRNN_SHELL_CMD:-<default>}"

module load openmpi/4.1.6-gcc-13.2.0 2>/dev/null || true

echo "GRID_JOB -> STARTED"
if [[ -n "${LRNN_SHELL_CMD:-}" ]]; then
  bash -lc "${LRNN_SHELL_CMD}"
else
  uv run bash scripts/smoke_all_architectures.sh --cpu
fi
echo "GRID_JOB -> ENDED"
