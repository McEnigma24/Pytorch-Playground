#!/bin/bash
# Jeden model RNN — 1× GPU (bez array). LRNN_ARCH wymagane (przy sbatch --export).
#SBATCH --job-name=lrnn_1ep
#SBATCH --account=plgar2026-gpu
#SBATCH --partition=plgrid-gpu-v100
#SBATCH --gres=gpu:1
#SBATCH --time=24:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --output=grid/output/rnn1ep_%j.out
#SBATCH --error=grid/output/rnn1ep_%j.err

set -euo pipefail

: "${LRNN_ARCH:?ustaw LRNN_ARCH (np. rnnLSTM)}"

cd "$SLURM_SUBMIT_DIR"
# shellcheck source=/dev/null
[[ -f local/env.sh ]] && source local/env.sh

PROJECT_ROOT="${LANGUAGE_RNN_ROOT:-$SLURM_SUBMIT_DIR}"
cd "$PROJECT_ROOT"
export PYTHONPATH="${PROJECT_ROOT}/src:${PYTHONPATH:-}"
export LANGUAGE_RNN_ROOT="$PROJECT_ROOT"
export TENSORBOARD_LOGDIR="${SCRATCH:-/tmp}/lrnn_runs/one_${SLURM_JOB_ID}"

module load cuda
nvidia-smi

mkdir -p grid/output
echo "Job $SLURM_JOB_ID → ${LRNN_ARCH}"
echo "TENSORBOARD_LOGDIR=$TENSORBOARD_LOGDIR"

uv run python scripts/plgrid/run_train.py \
  --architecture "$LRNN_ARCH" \
  --preset test125M_1ep \
  --tensorboard-root "$TENSORBOARD_LOGDIR"
