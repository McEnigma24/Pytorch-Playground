#!/bin/bash
#SBATCH --job-name=lrnn_gpu
#SBATCH --account=plgar2026-gpu
#SBATCH --partition=plgrid-gpu-v100
#SBATCH --gres=gpu:1
#SBATCH --time=24:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --output=grid/output/out_%j.txt
#SBATCH --error=grid/output/err_%j.txt

set -euo pipefail

cd "$SLURM_SUBMIT_DIR"
# shellcheck source=/dev/null
[[ -f local/env.sh ]] && source local/env.sh

PROJECT_ROOT="${LANGUAGE_RNN_ROOT:-$SLURM_SUBMIT_DIR}"
export PYTHONPATH="${PROJECT_ROOT}/src:${PYTHONPATH:-}"
export LANGUAGE_RNN_ROOT="$PROJECT_ROOT"
export TENSORBOARD_LOGDIR="${TENSORBOARD_LOGDIR:-$SCRATCH/lrnn_runs/${SLURM_JOB_ID}}"

GPUS="${GPUS:-${SLURM_GPUS_ON_NODE:-1}}"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-${SLURM_CPUS_PER_TASK:-8}}"

echo "LANGUAGE_RNN_ROOT=${PROJECT_ROOT}"
echo "TENSORBOARD_LOGDIR=${TENSORBOARD_LOGDIR}"
echo "GPUS=${GPUS} LRNN_SHELL_CMD=${LRNN_SHELL_CMD:-<default>}"

module load cuda
nvidia-smi

cd "$PROJECT_ROOT"
mkdir -p grid/output

echo "GRID_JOB -> STARTED"
if [[ -n "${LRNN_SHELL_CMD:-}" ]]; then
  bash -lc "${LRNN_SHELL_CMD}"
else
  uv run python scripts/plgrid/run_train.py --architecture rnnLSTM --preset test125M_1ep \
    --tensorboard-root "$TENSORBOARD_LOGDIR"
fi
echo "GRID_JOB -> ENDED"
