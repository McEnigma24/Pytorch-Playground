1. Klasyczny baseline (w stylu najprostszych rozwiązań Kaggle)
To najczęstsza, podstawowa implementacja BiLSTM. Sieć bierze wektory słów, przepuszcza przez dwukierunkowe LSTM, a do klasyfikacji używa tylko ostatniego stanu ukrytego obu kierunków. To model podatny na zapominanie informacji z początku długich sekwencji.

Python
import torch
import torch.nn as nn

class BasicBiLSTM(nn.Module):
    def __init__(self, vocab_size, embed_size, hidden_size, num_classes):
        super(BasicBiLSTM, self).__init__()
        self.embedding = nn.Embedding(vocab_size, embed_size)
        # Standardowy dwukierunkowy LSTM
        self.lstm = nn.LSTM(embed_size, hidden_size, bidirectional=True, batch_first=True)
        # Klasyfikator przyjmuje rozmiar: hidden_size * 2 (bo dwa kierunki)
        self.fc = nn.Linear(hidden_size * 2, num_classes)

    def forward(self, x):
        # x: [batch_size, seq_len]
        embedded = self.embedding(x)

        # out to sekwencja wyjść, hidden to ostatni stan ukryty (dla każdego kierunku i warstwy)
        out, (hidden, cell) = self.lstm(embedded)

        # Pobieramy ostatnie stany ukryte dla kierunku "w przód" (forward) i "w tył" (backward)
        # i łączymy je ze sobą
        hidden_cat = torch.cat((hidden[-2, :, :], hidden[-1, :, :]), dim=1)

        return self.fc(hidden_cat)
2. AWD-LSTM (wariant z WeightDrop / DropConnect)
Kluczem do sukcesu AWD-LSTM nie jest architektura połączonych warstw, ale sposób regularyzacji. Zamiast standardowego Dropoutu (który po prostu wyłącza neurony na wyjściu), stosuje się WeightDrop (DropConnect) bezpośrednio na wewnętrznych macierzach wag LSTM (weight_hh). Poniższa implementacja tworzy wrapper, który za każdym przejściem forward losowo zeruje część wag macierzy ukrytych, zapobiegając przeuczeniu.

Python
import torch
import torch.nn as nn
import torch.nn.functional as F

class WeightDrop(nn.Module):
    """Wrapper aplikujący DropConnect na wagi ukryte modułu RNN"""
    def __init__(self, module, weights, dropout):
        super(WeightDrop, self).__init__()
        self.module = module
        self.weights = weights
        self.dropout = dropout
        self._setup()

    def _setup(self):
        # Podmieniamy oryginalne wagi na własne parametry (_raw)
        for name_w in self.weights:
            w = getattr(self.module, name_w)
            del self.module._parameters[name_w]
            self.module.register_parameter(name_w + '_raw', nn.Parameter(w.data))

    def _setweights(self):
        # Przed każdym krokiem uczenia nakładamy dropout na wagi
        for name_w in self.weights:
            raw_w = getattr(self.module, name_w + '_raw')
            w = F.dropout(raw_w, p=self.dropout, training=self.training)
            setattr(self.module, name_w, w)

    def forward(self, *args):
        self._setweights()
        return self.module(*args)

class CoreAWDLSTM(nn.Module):
    def __init__(self, vocab_size, embed_size, hidden_size, num_classes):
        super(CoreAWDLSTM, self).__init__()
        self.embedding = nn.Embedding(vocab_size, embed_size)

        # Podstawowy jednokierunkowy LSTM
        raw_lstm = nn.LSTM(embed_size, hidden_size, batch_first=True)
        # Nakładamy WeightDrop na macierz przejść ukrytych (hidden-to-hidden)
        self.lstm = WeightDrop(raw_lstm, ['weight_hh_l0'], dropout=0.5)

        self.fc = nn.Linear(hidden_size, num_classes)

    def forward(self, x):
        embedded = self.embedding(x)
        out, _ = self.lstm(embedded)
        # Klasyfikacja na podstawie ostatniego elementu sekwencji
        return self.fc(out[:, -1, :])
3. "Złoty Standard" (BiLSTM + Spatial Dropout + Concatenated Pooling)
To najsilniejsza z tych trzech sieci. Rozwiązuje problem "zapominania" długich sekwencji poprzez zrobienie statystyk (Max i Average Pooling) ze wszystkich tokenów naraz, przypominając nieco to, jak Transformer analizuje cały tekst równolegle. Wymaga też zastosowania Spatial Dropoutu.

Python
import torch
import torch.nn as nn

class SpatialDropout1D(nn.Module):
    """PyTorch nie ma wbudowanego SpatialDropout1D, robimy go przez Dropout2d"""
    def __init__(self, p):
        super(SpatialDropout1D, self).__init__()
        self.dropout2d = nn.Dropout2d(p=p)

    def forward(self, x):
        # Wejście: [batch, seq_len, embed_size]
        # Zamieniamy miejscami wymiary dla Dropout2d, który oczekuje kanałów na 2. wymiarze
        x = x.permute(0, 2, 1)
        x = self.dropout2d(x)
        x = x.permute(0, 2, 1)
        return x

class GoldenBaselineRNN(nn.Module):
    def __init__(self, vocab_size, embed_size, hidden_size, num_classes):
        super(GoldenBaselineRNN, self).__init__()
        self.embedding = nn.Embedding(vocab_size, embed_size)

        # 1. Spatial Dropout (zeruje całe wektory słów zamiast pojedynczych wartości)
        self.spatial_dropout = SpatialDropout1D(0.25)

        # 2. BiLSTM
        self.lstm = nn.LSTM(embed_size, hidden_size, bidirectional=True, batch_first=True)

        # 3. Rozmiar wejścia do Dense:
        # hidden_size * 2 (bo BiLSTM) * 3 (bo łączymy Last_Hidden + Max_Pool + Avg_Pool)
        fc_input_size = hidden_size * 2 * 3

        self.fc1 = nn.Linear(fc_input_size, 256)
        self.relu = nn.ReLU()
        self.dropout = nn.Dropout(0.5)
        self.fc2 = nn.Linear(256, num_classes)

    def forward(self, x):
        # x: [batch, seq_len]
        emb = self.embedding(x)
        emb = self.spatial_dropout(emb)

        # out ma kształt: [batch, seq_len, hidden_size * 2]
        out, _ = self.lstm(emb)

        # GLOBAL POOLING Z CAŁEJ SEKWENCJI:
        # A. Ostatni stan ukryty
        last_hidden = out[:, -1, :]

        # B. Average Pooling ze wszystkich słów
        avg_pool = torch.mean(out, dim=1)

        # C. Max Pooling ze wszystkich słów
        max_pool, _ = torch.max(out, dim=1)

        # D. Konkatenacja wszystkiego w jeden gigantyczny wektor kontekstu
        concatenated = torch.cat((last_hidden, max_pool, avg_pool), dim=1)

        # Przepuszczenie przez warstwy klasyfikatora
        x = self.fc1(concatenated)
        x = self.relu(x)
        x = self.dropout(x)
        logits = self.fc2(x)

        return logits