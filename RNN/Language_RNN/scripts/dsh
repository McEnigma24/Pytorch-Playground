#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

# shellcheck source=scripts/_compose_env.sh
source "${ROOT}/scripts/_compose_env.sh"

if docker ps --format '{{.Names}}' | grep -qx "${SHELL_CONTAINER_NAME}"; then
  docker exec "${SHELL_CONTAINER_NAME}" bash -lc 'cd /workspace && uv sync'
  exec docker exec -it "${SHELL_CONTAINER_NAME}" bash --rcfile /workspace/docker/shell_init.sh
fi

exec "${COMPOSE[@]}" run --rm --service-ports --name "${SHELL_CONTAINER_NAME}" dev bash
