#!/bin/bash
#SBATCH --job-name=lrnn_rnn1ep
#SBATCH --account=plgar2026-gpu
#SBATCH --partition=plgrid-gpu-v100
#SBATCH --array=0-5
#SBATCH --gres=gpu:1
#SBATCH --time=24:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --output=grid/output/rnn1ep_%A_%a.out
#SBATCH --error=grid/output/rnn1ep_%A_%a.err

set -euo pipefail

ARCHITECTURES=(
  rnnRNN rnnGRU rnnLSTM
  rnnAWDLSTM rnnBaseLSTM rnnGoldenLSTM
)
ARCH="${ARCHITECTURES[$SLURM_ARRAY_TASK_ID]}"

cd "$SLURM_SUBMIT_DIR"
# shellcheck source=/dev/null
[[ -f local/env.sh ]] && source local/env.sh

PROJECT_ROOT="${LANGUAGE_RNN_ROOT:-$SLURM_SUBMIT_DIR}"
cd "$PROJECT_ROOT"
export PYTHONPATH="${PROJECT_ROOT}/src:${PYTHONPATH:-}"
export LANGUAGE_RNN_ROOT="$PROJECT_ROOT"
export TENSORBOARD_LOGDIR="${SCRATCH:-/tmp}/lrnn_runs/${SLURM_ARRAY_JOB_ID}"

module load cuda
nvidia-smi

mkdir -p grid/output
echo "Job $SLURM_JOB_ID task $SLURM_ARRAY_TASK_ID → $ARCH"
echo "TENSORBOARD_LOGDIR=$TENSORBOARD_LOGDIR"

uv run python scripts/plgrid/run_train.py \
  --architecture "$ARCH" \
  --preset test125M_1ep \
  --tensorboard-root "$TENSORBOARD_LOGDIR"
