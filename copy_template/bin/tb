#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=bin/_bg.sh
source /workspace/bin/_bg.sh

NAME=tensorboard
PIDFILE=/workspace/build/run/tensorboard.pid
LOGFILE=/workspace/build/logs/tensorboard.log
LOGDIR="${TENSORBOARD_LOGDIR:-/workspace/runs}"
PORT=6006
HOST_PORT="${TENSORBOARD_PORT:-6006}"
URL="http://127.0.0.1:${HOST_PORT}/"

cmd="${1:-start}"
case "$cmd" in
  start)
    bg_start "$NAME" "$PIDFILE" "$LOGFILE" \
      tensorboard --logdir "$LOGDIR" --host 0.0.0.0 --port "$PORT"
    echo "TensorBoard: ${URL}"
    ;;
  stop)
    bg_stop "$NAME" "$PIDFILE"
    ;;
  status)
    bg_status "$NAME" "$PIDFILE"
    ;;
  logs)
    bg_logs "$LOGFILE"
    ;;
  *)
    echo "Użycie: tb [start|stop|status|logs]" >&2
    exit 1
    ;;
esac
